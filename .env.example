# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qpforge

# ─── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-key
JWT_REFRESH_SECRET=change-me-refresh-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ─── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Uploads ─────────────────────────────────────────────
MAX_UPLOAD_MB=25
UPLOAD_DIR=./uploads

# ─── Export ──────────────────────────────────────────────
PDF_WORKER_CONCURRENCY=2
